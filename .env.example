# Copy to .env for local development. Never commit real values.
# Local values below match docker-compose.yml. Final set is owned by the server config (T2).

# Postgres, pooled connection (app runtime). Local Docker Postgres listens on 5433.
DATABASE_URL=postgresql://app:app@localhost:5433/app
# Postgres, direct connection (migrations). Same database locally.
DATABASE_URL_UNPOOLED=postgresql://app:app@localhost:5433/app

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this deployment.
BETTER_AUTH_URL=http://localhost:5173

# OAuth Proxy secret for preview deployments. Not needed locally.
OAUTH_PROXY_SECRET=

# Google OAuth. Optional outside production: when unset the Google provider is
# not registered and sign-in reports it is not configured. Required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
