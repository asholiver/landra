# Copy to .env for local development. Never commit real values.
# Local values below match docker-compose.yml. The authoritative list and validation rules are in
# src/server/config.ts.

# Postgres, pooled connection (app runtime). Local Docker Postgres listens on 5433.
DATABASE_URL=postgresql://app:app@localhost:5433/app
# Postgres, direct connection (migrations). Same database locally.
DATABASE_URL_UNPOOLED=postgresql://app:app@localhost:5433/app

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of this deployment.
BETTER_AUTH_URL=http://localhost:5173

# OAuth Proxy secret for preview deployments. Not needed locally.
OAUTH_PROXY_SECRET=

# Google OAuth. Optional outside production: when unset the Google provider is
# not registered and sign-in reports it is not configured. Required in production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: production URL registered with Google, used by the OAuth Proxy on previews.
# Defaults to BETTER_AUTH_URL. OAUTH_PROXY_SECRET must be at least 32 characters.
OAUTH_PROXY_PRODUCTION_URL=

# Build version reported by /healthz. CI sets GIT_SHA; Vercel sets VERCEL_GIT_COMMIT_SHA.
GIT_SHA=

# Integration tests only. Required, no default. Maintenance connection to the disposable
# `postgres-test` server (docker compose up -d postgres-test). Each run creates and removes its
# own database on it. Tests refuse any other host, port or server. Vitest does not read .env,
# so pass it on the command line (see README).
TEST_DATABASE_URL=postgresql://app:app@127.0.0.1:5434/postgres
